# Production Environment Variables Template
# Security Prerequisites for Phase 5 Week 1 Deployment
#
# Usage:
#   1. Copy this file to .env.production
#   2. Fill in actual values (DO NOT commit .env.production)
#   3. Source the file before deployment: source .env.production
#   4. Run security validation: ./scripts/validate-security-prerequisites.sh
#   5. Run environment validation: ./scripts/validate-environment.sh
#

# ==============================================================================
# Kafka Connection Configuration
# ==============================================================================

# Kafka bootstrap servers (comma-separated list of broker addresses)
# Example: kafka1.internal:9093,kafka2.internal:9093,kafka3.internal:9093
KAFKA_BOOTSTRAP_SERVERS=

# ==============================================================================
# SASL/SSL Security Configuration
# ==============================================================================

# SASL username for Kafka authentication
# Pattern: cryptofeed-{environment} (e.g., cryptofeed-prod, cryptofeed-staging)
KAFKA_SASL_USERNAME=

# SASL password for Kafka authentication
# CRITICAL: Store in vault, not environment variables (this is temporary bootstrap)
KAFKA_SASL_PASSWORD=

# ==============================================================================
# SSL Certificate Paths
# ==============================================================================

# Path to client SSL certificate
# Example: /etc/ssl/certs/kafka-client.pem
KAFKA_SSL_CERT=

# Path to client SSL private key
# Example: /etc/ssl/private/kafka-client-key.pem
KAFKA_SSL_KEY=

# Path to Certificate Authority (CA) certificate
# Example: /etc/ssl/certs/kafka-ca.pem
KAFKA_SSL_CA=

# ==============================================================================
# Vault Configuration (Secret Management)
# ==============================================================================

# Vault server address (MUST use HTTPS)
# Example: https://vault.internal:8200
VAULT_ADDR=

# Vault authentication token
# CRITICAL: Rotate regularly, use role-based access
VAULT_TOKEN=

# ==============================================================================
# Metrics & Monitoring Configuration
# ==============================================================================

# Metrics endpoint authentication username
# Used by Prometheus to scrape /metrics endpoint
METRICS_AUTH_USER=

# Metrics endpoint authentication password
# CRITICAL: Use strong password, rotate regularly
METRICS_AUTH_PASSWORD=

# Prometheus server URL
# Example: http://prometheus.internal:9090
PROMETHEUS_URL=

# Grafana server URL
# Example: http://grafana.internal:3000
GRAFANA_URL=

# Grafana API key for dashboard deployment
# CRITICAL: Use service account token, rotate regularly
GRAFANA_API_KEY=

# ==============================================================================
# Network & Security Policies
# ==============================================================================

# Kubernetes namespace (if using Kubernetes network policies)
# Example: cryptofeed
K8S_NAMESPACE=cryptofeed

# ==============================================================================
# Optional Configuration
# ==============================================================================

# TLS protocol version (default: TLSv1.3)
# Options: TLSv1.2, TLSv1.3
KAFKA_TLS_VERSION=TLSv1.3

# Kafka SASL mechanism (default: PLAIN)
# Options: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512
KAFKA_SASL_MECHANISM=PLAIN

# Enable debug logging (default: false)
# Options: true, false
DEBUG=false

# ==============================================================================
# Deployment Environment
# ==============================================================================

# Environment identifier
# Options: production, staging, development
ENVIRONMENT=production

# Deployment timestamp (auto-generated during deployment)
DEPLOYMENT_TIMESTAMP=

# ==============================================================================
# Validation
# ==============================================================================
# Run security validation before deployment:
#   ./scripts/validate-security-prerequisites.sh
#
# Expected output:
#   ✓ SASL/SSL certificates validated
#   ✓ Service accounts validated
#   ✓ Vault secrets validated
#   ✓ TLS enabled for Kafka connections
#   ✓ Metrics endpoints protected
#   ✓ Network policies configured
#
#   All security checks passed
#   Ready for Week 1 deployment
#
# Run environment variable validation before deployment:
#   ./scripts/validate-environment.sh
#
# Expected output:
#   ✓ All required environment variables validated
#   Ready for deployment
# ==============================================================================
